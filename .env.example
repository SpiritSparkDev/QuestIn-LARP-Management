PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://app:app@localhost:5432/pakyrion
ENCRYPTION_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@pakyrion.local
APP_BASE_URL=http://localhost:3000
# Leave SMTP_HOST empty for local dev/tests — mail falls back to a no-network JSON transport.
