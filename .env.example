# Full reference of every variable the app understands. For a production
# launch only the "required" section matters — see .env for the minimal set
# actually used; everything below it has a working default and can be left
# unset until you need the feature.

# Maintenance: set MAINTENANCE_MODE=1 and restart to show the 503 page to everyone (API answers 503 too);
# remove it and restart to go back online. /health, assets and branding stay reachable.
# MAINTENANCE_MODE=

# 1 switches off the per-address rate limits (the production compose file defaults to 1; 0 turns them on again).
# The lock after 5 wrong passwords for one account stays either way.
# RATE_LIMIT_DISABLED=

# Number of reverse proxies in front of the app (Plesk/nginx = 1). The production compose file sets 1 by default.
# Needed so rate limits count per visitor and not all visitors together; leave unset for direct access.
# TRUST_PROXY=1

# --- Required ---------------------------------------------------------

POSTGRES_DB=pakyrion
POSTGRES_USER=app
POSTGRES_PASSWORD=

ENCRYPTION_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this after data has been encrypted makes that data unreadable.

APP_BASE_URL=http://localhost:3000
# Used in verification/password-reset email links. Set to the real public
# URL on the live server.

ADMINUSER=
ADMINPASS=
# If both are set, an admin account is created on startup with this email/
# password (skipped if a user with that email already exists — safe to
# leave set across restarts/redeploys).

# --- Optional (have working defaults) ----------------------------------

APP_PORT=3000
# Host-side port the app is published on (container always listens on 3000
# internally). Change this if 3000 is already taken on the host.
LOG_LEVEL=info

# Only used for scripts (e.g. npm run migrate) run on the host outside
# docker; both compose files set DATABASE_URL for the app container
# themselves from the POSTGRES_* vars above.
DATABASE_URL=postgres://app:app@localhost:5432/pakyrion

# Bootstrap SMTP fallback — can also be configured later via the admin UI
# (stored in the DB, takes precedence over these). Leave SMTP_HOST empty to
# fall back to a no-network JSON transport (mail is logged, not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@pakyrion.local

# Social login — leave empty to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Backup service (docker-compose.yml, see docs/betrieb-backup.md). All optional.
# BACKUP_CRON=17 3 * * *            # schedule (UTC); hourly before a con: 17 * * * *
# KEEP_DAILY=7  KEEP_WEEKLY=4  KEEP_MONTHLY=6
# BACKUP_AGE_RECIPIENT=             # age public key; encrypts the backup files
# BACKUP_PING_URL=                  # heartbeat URL (e.g. healthchecks.io), /fail on error
# BACKUP_OFFSITE_REMOTE=            # rclone target, e.g. offsite:bucket/questin
# RCLONE_CONFIG_OFFSITE_TYPE=s3     # + _PROVIDER/_ENDPOINT/_REGION/_ACCESS_KEY_ID/_SECRET_ACCESS_KEY
#                                   #   or type=sftp with _HOST/_PORT/_USER/_PASS (rclone obscure)
